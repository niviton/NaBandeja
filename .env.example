# Configuração do NaBandeja. O sistema cria um .env sozinho no primeiro início;
# este arquivo serve de referência. Detalhes em docs/seguranca.md.

# ---- Segurança (obrigatório em produção)
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=gere-com: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Libera automaticamente o IP e o nome do PC na rede local.
AUTO_ALLOW_LOCAL_HOSTS=true
# Origens extras para formulários (só se acessar por outro domínio/porta).
# DJANGO_CSRF_TRUSTED_ORIGINS=https://meurestaurante.com

# ---- HTTPS (depois de rodar deploy/windows/setup_ssl.bat)
USE_HTTPS=false
HTTPS_PORT=443

# ---- Servidor
# Endereço dos QR Codes impressos, se o sistema tiver endereço na internet.
# PUBLIC_BASE_URL=https://cardapio.minhaloja.com.br
APP_HOST=0.0.0.0
APP_PORT=8000
ENABLE_REALTIME=true

# ---- Login com Google (opcional, veja docs/login-google.md)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- Login
NABANDEJA_INIT_ADMIN_PASSWORD=troque-esta-senha
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# ---- Banco (padrão: SQLite, arquivo db.sqlite3)
DB_ENGINE=sqlite
SQLITE_TIMEOUT=20
# DB_ENGINE=postgres
# POSTGRES_DB=nabandeja
# POSTGRES_USER=nabandeja
# POSTGRES_PASSWORD=troque-esta-senha
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=prefer

# ---- Tempo real (docs/tempo-real.md)
# auto: WebSocket com polling de reserva | websocket | polling | off
REALTIME_TRANSPORT=auto
REALTIME_POLL_SECONDS=4
# Vários processos/servidores (Railway, VPS): pip install -r requirements/redis.txt
# REDIS_URL=redis://localhost:6379/0
# Banco por URL (Railway): DATABASE_URL=postgres://usuario:senha@host:5432/banco

# ---- Backup externo criptografado (vem pronto no pacote do painel master)
# NABANDEJA_BACKUP_REPO=git@github.com:SEU_USUARIO/nabandeja-dados-minha-loja.git
# NABANDEJA_BACKUP_CHAVE_PUBLICA=
# BACKUP_REMOTO_DIAS=14

# ---- Painel master (só no PC do dono do NaBandeja; docs/master.md)
# NABANDEJA_MODO=master
# NABANDEJA_MASTER_DIR=C:\Users\voce\NaBandejaMaster
# NABANDEJA_GITHUB_OWNER=seu-usuario-ou-organizacao
# NABANDEJA_GITHUB_TOKEN=github_pat_...
# NABANDEJA_REPOS_DIR=D:\Backups\NaBandeja   (alternativa ao GitHub: pasta/disco de rede)
